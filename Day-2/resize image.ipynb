   "source": [
    "import cv2\n",
    "image = cv2.imread('data\\images.jpg')\n",
    "print ('image shape:', image.shape)\n",
    "resized = cv2.resize(image, (300, 400))\n",
    "print ('resized shape:', resized.shape)\n",
    "cv2.imshow('original', image)\n",
    "cv2.imshow('output', resized)\n",
    "cv2.waitKey(0)\n",
    "cv2.destroyAllWindows()"
   ]
  }
