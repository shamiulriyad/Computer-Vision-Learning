   "source": [
    "import cv2\n",
    "image=cv2.imread('data\\images.jpg')\n",
    "print('image shape:', image.shape)\n",
    "crop_image=image[100:400, 200:500]\n",
    "print('crop_image shape:', crop_image.shape)\n",
    "cv2.imshow('original', image)\n",
    "cv2.imshow('output', crop_image)\n",
    "cv2.waitKey(0)\n",
    "cv2.destroyAllWindows()\n"
   ]
  }
